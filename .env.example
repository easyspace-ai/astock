# ===== TickFlow =====
# 留空或不填则启用 Free 试用模式(TickFlow.free()),仅能拿历史日 K 单股数据
TICKFLOW_API_KEY=

# ===== AI(可选,留空跳过 AI 功能) =====
AI_PROVIDER=openai_compat          # openai_compat | ollama
AI_BASE_URL=https://api.deepseek.com/v1
AI_API_KEY=
AI_MODEL=deepseek-chat
AI_DAILY_TOKEN_BUDGET=500000

# ===== Server =====
HOST=0.0.0.0
PORT=3018
LOG_LEVEL=INFO

# ===== 可观测性 / 系统告警 =====
# 系统告警写入 user_data/alerts.jsonl + SSE，并在已配置的飞书/企业微信/自定义 Webhook 上推送。
OPS_ALERT_ENABLED=true
OPS_ALERT_COOLDOWN_S=1800
OPS_DISK_WARN_GB=10
OPS_DISK_CRITICAL_GB=2
OPS_MONITOR_INTERVAL_S=60
OPS_HTTP_5XX_WINDOW_S=300
OPS_HTTP_5XX_THRESHOLD=5
# 文件日志轮转（backend.log INFO+ / error.log ERROR+）
LOG_FILE_MAX_MB=20
LOG_FILE_BACKUP_COUNT=5
ERROR_LOG_MAX_MB=20
ERROR_LOG_BACKUP_COUNT=5

# ===== 多用户账号（可选）=====
# 首次启动时用环境变量创建管理员账号（仅当系统还没有任何账号时生效）。
# 两个都要填才创建；之后可在页面注册其他账号，首个注册账号也会自动成为管理员。
# 管理员邮箱 / 密码
ADMIN_EMAIL=''
ADMIN_PASSWORD=''

# Optional backend dependency extras for Docker and ./dev.sh / .\dev.ps1.
# Set to legacy-cpu on older CPUs without AVX2/FMA support.
# Combine with backtest as: legacy-cpu backtest
BACKEND_EXTRAS=

# ===== Data =====
# 源码运行按项目根目录解析；Docker 相对路径按 /app 解析。
# Docker 推荐显式设置 DATA_DIR=/app/data，并把宿主机目录挂载到同一路径。
DATA_DIR=./data
