# ============================================================
# aistock backend .env.example → 复制为 .env 并填入真实值
# ============================================================

# 必填：统一数据根目录（lake/parquet、duckdb、tusharedb-go 缓存等均在此目录下）
# 注意：本仓库不含 a-stock-data/ 目录；UZI-Skill 文档中的 a-stock-data 对应此 AI_DATA_DIR
AI_DATA_DIR=/path/to/aistock-data

# 服务端口（panel 反代默认指向 8787，见仓库根 .env AISTOCK_URL）
PORT=8787

# 本机 Panel FastAPI（get_stock_data 优先拉 /api/kline/daily 前复权日 K）
PANEL_API_URL=http://127.0.0.1:7300
# Panel K 线短超时（毫秒）；超时立刻回退腾讯。默认 4000
PANEL_KLINE_TIMEOUT_MS=4000
# 末级 tsdb 只读查询超时（毫秒）；不触发东财 live sync。默认 5000
# TSDB_FALLBACK_TIMEOUT_MS=5000

# tickflow-stock-panel 旁路模式：保留 analysis/picker/market；关内嵌前端；
# workspace / hotmoney / TDX 默认不启（见下方可选开关）
AISTOCK_SIDECAR=1
# AISTOCK_SERVE_WEB=1          # sidecar 下仍托管内嵌前端（一般不需要）
# AISTOCK_ENABLE_HOTMONEY=1    # 启用游资/UZI 路由
# AISTOCK_ENABLE_TDX=1         # 启用 /api/v1/tdx
# OBSIDIAN_FS_ROOT=/path       # 显式设置后 sidecar 也会挂载 workspace

# Tushare 数据源（https://tushare.pro 注册获取）
TUSHARE_TOKEN=

# AI 模型（DeepSeek / OpenAI / 本地 Ollama 等）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-chat

# 可选：W6 新闻预取（缺失时 analysis 新闻侧降级，服务仍可启动）
# AI_SDK_BASE_URL=
# AI_SDK_SERVICE_API_KEY=
# AI_SDK_UPLOAD_PATH=/api/upload

# 可选：游资看盘 UZI-Skill（sidecar 默认不启；需 AISTOCK_ENABLE_HOTMONEY=1）
# HOTMONEY_UZI_DIR=../UZI-Skill
# HOTMONEY_UZI_PYTHON=/path/to/UZI-Skill/.venv/bin/python
# HOTMONEY_REPORT_MODE=llm
# HOTMONEY_UZI_DEPTH=lite
# HOTMONEY_UZI_TIMEOUT=25m

# 可选：分析报告 SQLite 路径
# AIGOSTOCK_SQLITE_PATH=data/aigostock.db

# 可选：认证（sidecar 下 analysis/picker/market 无需登录；/api/v1/auth 仍可用）
# AUTH_JWT_SECRET=change_me_in_production

# 可选：StockAPI 缓存
# STOCKAPI_CACHE_MODE=auto
